#!/bin/sh
# KRouter MCP launcher, the same way session_hook does it: .claude-plugin/plugin.json
# asks for "mcp_server", Windows finds mcp_server.cmd through PATHEXT, POSIX runs this
# file. python3 is not tried on Windows, where it is the Microsoft Store alias that
# exits 9009 in silence.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 127
for py in python3 python; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$here/mcp_server.py" "$@"
    fi
done
echo "KRouter: neither python3 nor python is on PATH (see docs/INSTALL.md)" >&2
exit 127
